# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# IDs Discord des propriétaires du bot, séparés par des virgules
# (accès aux commandes /stream, /dnd, /status, /serverlist, /leaveserver, /eval-like...)
OWNER_IDS=

# (Optionnel) ID d'un serveur de test : les commandes y sont enregistrées instantanément
DEV_GUILD_ID=

# Dossier de stockage de la base JSON. Sur Railway, montez un Volume sur /data
# et mettez DATA_DIR=/data pour que la config survive aux redéploiements.
DATA_DIR=./data

# Mettre à true si l'intent "Presence" est activé dans le Developer Portal
# (donne le statut / l'appareil du membre dans la fiche de vérification)
ENABLE_PRESENCES=false

# ---------- Site web public (membres, salons et rôles en direct) ----------
# Le site démarre avec le bot. Sur Railway : Settings > Networking > Generate Domain.
# Mettre false pour le désactiver.
SITE_ENABLED=true
# Port d'écoute (Railway fournit PORT automatiquement)
SITE_PORT=3000
# Serveur affiché (par défaut : le serveur le plus peuplé du bot)
SITE_GUILD_ID=
# Adresse publique du site, affichée par /site lien
SITE_URL=
# Lien d'invitation du bouton « Rejoindre » (par défaut : l'URL personnalisée du serveur)
SITE_INVITE_URL=
# Moyen de contact affiché dans les pages légales (par défaut : le modmail du serveur)
SITE_CONTACT=
